# Git attributes: normalize text line endings and mark binary assets
* text=auto

*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.example text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sh text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.whl binary
