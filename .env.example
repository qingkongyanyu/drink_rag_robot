# ============ Drink RAG Robot 配置示例 ============
# 复制本文件为 .env 并填写你的配置：
#   cp .env.example .env   （Windows: copy .env.example .env）

# ---------------- 千问大模型（必填） ----------------
# 在 https://dashscope.console.aliyun.com/ 创建 API-KEY
LLM_API_KEY=sk-your-api-key-here
# 可选模型：qwen-turbo（快/便宜） / qwen-plus（推荐） / qwen-max（最强）
LLM_MODEL=qwen-plus
# OpenAI 兼容基础地址（openai SDK base_url，不含 /chat/completions），千问官方；切换其他兼容服务商改这里
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兼容旧配置：旧 .env 里的 LLM_API_URL（完整端点 /chat/completions）仍会被识别并自动去掉后缀；
# 新项目推荐只配上面的 LLM_BASE_URL 即可。
# LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ---------------- 服务 ----------------
HOST=0.0.0.0
PORT=8006
DEBUG=false

# ---------------- RAG 检索（可选调整） ----------------
RAG_TOP_K=4
RAG_RETRIEVE_K=20
RAG_RERANK_K=6
# 交叉编码器重排：需联网下载 bge-reranker-base（约560MB），下载完成后改为 true 生效
RAG_USE_RERANKER=false
RAG_USE_RRF=true
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_SIMILARITY_THRESHOLD=0.3
ENABLE_QUERY_REWRITE=true

# 回复文本最大字符数（超出部分截断）
LLM_MAX_OUTPUT_CHARS=2000

# 模型下载源（默认已启用国内镜像，无需修改；如有特殊网络可覆盖为官方源）
# HF_ENDPOINT=https://huggingface.co
