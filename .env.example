# ============ Drink RAG Robot 配置示例 ============
# 复制本文件为 .env 并填写你的配置：
#   cp .env.example .env   （Windows: copy .env.example .env）

# ---------------- 千问大模型（必填） ----------------
# 在 https://dashscope.console.aliyun.com/ 创建 API-KEY
LLM_API_KEY=sk-your-api-key-here
# 可选模型：qwen-turbo（快/便宜） / qwen-plus（推荐） / qwen-max（最强）
LLM_MODEL=qwen-plus
# OpenAI 兼容端点（千问官方），如需切换其他兼容模型服务商可整体替换
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# ---------------- 服务 ----------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------------- RAG 检索（可选调整） ----------------
RAG_TOP_K=4
RAG_RETRIEVE_K=20
RAG_RERANK_K=6
# 交叉编码器重排：需联网下载 bge-reranker-base（约560MB），下载完成后改为 true 生效
RAG_USE_RERANKER=false
RAG_USE_RRF=true
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_SIMILARITY_THRESHOLD=0.3
ENABLE_QUERY_REWRITE=true

# 模型下载源（默认已启用国内镜像，无需修改；如有特殊网络可覆盖为官方源）
# HF_ENDPOINT=https://huggingface.co
